# Copy this file to .env and fill in your values.
# Then, before running the bot, load it into your shell, e.g.:
#   set -a && source .env && set +a

ROBINHOOD_USERNAME=your_robinhood_email@example.com
ROBINHOOD_PASSWORD=your_robinhood_password

# Optional: only needed if you want the bot to run fully unattended without
# a manual 2FA prompt. This is your TOTP secret (the same secret you'd type
# into an authenticator app), NOT a one-time code. Get it from Robinhood's
# account security settings when setting up an authenticator app.
ROBINHOOD_TOTP_SECRET=

# Set to "true" to let the bot place REAL orders. Left unset/false, the bot
# runs in TEST MODE: it reads real prices/account data and logs exactly what
# it would have bought or sold, but places no orders. This is the safe default.
SOXL_BOT_LIVE_TRADING=false

# Optional overrides
# SOXL_BOT_STATE_FILE=/home/youruser/soxl_bot/soxl_bot_state.json
# SOXL_BOT_LOG_DIR=/home/youruser/soxl_bot/logs
# SOXL_BOT_RESPECT_MARKET_HOURS=true